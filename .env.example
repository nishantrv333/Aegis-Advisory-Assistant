# Copy to .env and fill in. Everything here has a working default except
# the API key, and even that is optional. With no key, Aegis runs in
# deterministic mode using the rule based fallback in every agent.

# --- LLM ---------------------------------------------------------------
# groq | anthropic | mock
LLM_PROVIDER=groq

# Get a free key at https://console.groq.com
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# To run against Claude instead, set LLM_PROVIDER=anthropic, uncomment
# anthropic in requirements.txt, and fill this in. No other changes.
# ANTHROPIC_API_KEY=sk-ant-your_key_here
# ANTHROPIC_MODEL=claude-sonnet-4-5

LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1600

# --- Retrieval ---------------------------------------------------------
# auto = try ChromaDB's MiniLM model, fall back to the offline hashing
#        embedder if it can't be downloaded
# hash = always use the offline embedder (deterministic; used by the evals)
EMBEDDING_MODE=auto
CHROMA_PATH=.chroma
CHROMA_COLLECTION=aegis_market_research
CHUNK_CHARS=900
CHUNK_OVERLAP=150
RETRIEVAL_K=5

# --- App ---------------------------------------------------------------
VERBOSE_TRACE=true
